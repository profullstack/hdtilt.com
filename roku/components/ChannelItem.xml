<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the channel / title list: logo, number (or year), name. -->
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="showContent" />
    <field id="focusPercent" type="float" onChange="showFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/ChannelItem.brs" />
  <children>
    <Poster id="logo" translation="[16,8]" width="128" height="72" loadDisplayMode="scaleToFit" />
    <Label id="num" translation="[160,0]" width="120" height="88" vertAlign="center" color="#8b98a8" font="font:MediumSystemFont" />
    <Label id="name" translation="[290,0]" width="900" height="88" vertAlign="center" color="#e6edf3" font="font:MediumBoldSystemFont" />
  </children>
</component>
