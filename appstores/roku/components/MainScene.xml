<?xml version="1.0" encoding="utf-8"?>
<!-- hdtilt on Roku: sign in with a code, then a rail (Favorites, All, Search,
     Movies, Shows, groups) beside a list, and the picture. -->
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/util.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="#0b0f14" />

    <!-- Sign in -->
    <Group id="linkGroup" visible="false">
      <Poster translation="[810,110]" width="300" height="225" uri="pkg:/images/icon_focus_fhd.png" />
      <Label translation="[0,400]" width="1920" horizAlign="center" color="#e6edf3" font="font:LargeBoldSystemFont" text="Connect hdtilt to your account" />
      <Label id="linkUrl" translation="[0,500]" width="1920" horizAlign="center" color="#8b98a8" font="font:MediumSystemFont" text="On your phone or computer, go to hdtilt.com/link" />
      <Label id="linkCode" translation="[0,580]" width="1920" horizAlign="center" color="#38bdf8" font="font:LargeBoldSystemFont" text="" />
      <Label translation="[0,700]" width="1920" horizAlign="center" color="#8b98a8" font="font:SmallSystemFont" text="Sign in there (or create a free account), enter the code, and this screen opens your playlists." />
      <Label id="linkNote" translation="[0,760]" width="1920" horizAlign="center" color="#8b98a8" font="font:SmallSystemFont" text="" />
    </Group>

    <!-- Loading, errors, "press OK to try again" -->
    <Label id="message" translation="[160,400]" width="1600" height="300" horizAlign="center" vertAlign="center" wrap="true" color="#e6edf3" font="font:MediumSystemFont" visible="false" />

    <!-- Browse -->
    <Group id="browse" visible="false">
      <Label id="title" translation="[60,40]" color="#38bdf8" font="font:LargeBoldSystemFont" text="hdtilt" />
      <Label id="playlistName" translation="[300,56]" width="900" color="#8b98a8" font="font:SmallSystemFont" />
      <Label id="hint" translation="[1060,56]" width="800" horizAlign="right" color="#8b98a8" font="font:SmallSystemFont" text="* for options" />
      <LabelList id="rail" translation="[60,140]" itemSize="[500,64]" numRows="13" vertFocusAnimationStyle="floatingFocus" color="#e6edf3" focusedColor="#0b0f14" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
      <Label id="listHead" translation="[620,100]" width="1240" color="#8b98a8" font="font:SmallSystemFont" />
      <MarkupList id="list" translation="[620,140]" itemComponentName="ChannelItem" itemSize="[1240,88]" itemSpacing="[0,6]" numRows="10" vertFocusAnimationStyle="floatingFocus" />
    </Group>

    <Video id="video" width="1920" height="1080" visible="false" enableUI="true" />

    <!-- What's on: shown on every channel change, then fades. -->
    <Group id="banner" visible="false">
      <Rectangle translation="[0,900]" width="1920" height="180" color="#0b0f14E6" />
      <Poster id="bannerLogo" translation="[60,930]" width="200" height="112" loadDisplayMode="scaleToFit" />
      <Label id="bannerNum" translation="[290,940]" width="160" color="#38bdf8" font="font:LargeBoldSystemFont" />
      <Label id="bannerName" translation="[460,940]" width="1400" color="#e6edf3" font="font:LargeBoldSystemFont" />
      <Label id="bannerSub" translation="[460,1010]" width="1400" color="#8b98a8" font="font:SmallSystemFont" />
    </Group>

    <Timer id="pollTimer" repeat="true" duration="5" />
    <Timer id="focusTimer" repeat="false" duration="0.35" />
    <Timer id="bannerTimer" repeat="false" duration="4" />
  </children>
</component>
